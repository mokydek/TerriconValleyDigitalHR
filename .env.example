# ── Фронтенд (Vite) ─────────────────────────────────────────────
# Supabase → Project Settings → API. Публичные значения: их видит браузер,
# доступ к данным ограничивают политики RLS в базе.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon или publishable key>

# ── Серверная функция AI Jana (/api/ai-jana, Vercel) ────────────
# Задаются в Vercel → Settings → Environment Variables. НЕ коммитить!
# Без ключа AI Jana работает в режиме «строго по базе знаний»
# (локальный поиск по статьям с источником, без генерации текста).
ANTHROPIC_API_KEY=
# Модель и глубина рассуждений (необязательно)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
